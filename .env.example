# ==============================================================================
# CONFIGURAÇÕES DA APLICAÇÃO (BACK-END)
# ==============================================================================
# Este bloco define as propriedades básicas do servidor de aplicação.

# APP_HOSTNAME
# Define o nome do host ou domínio em que a aplicação será servida. 
# Utilizado internamente para referência de URLs.
# Exemplo: api.brainstormlabs.online
APP_HOSTNAME=localhost

# NODE_ENV
# Determina o ambiente em que o Node.js está operando. 
# Valores comuns: 'development', 'production', 'test'.
NODE_ENV=development

# APP_VERSION
# Especifica a versão atual da API, geralmente alinhada ao package.json.
APP_VERSION=1.0.0

# HTTP_PORT
# Define a porta local na qual o serviço do back-end escutará requisições HTTP.
HTTP_PORT=3006


# ==============================================================================
# CONFIGURAÇÕES DE TELEMETRIA E LOGS (ELASTICSEARCH)
# ==============================================================================
# Este bloco é utilizado caso haja integração com o Elasticsearch para 
# indexação e centralização de logs do sistema.

# ELASTICSEARCH_ACTIVE
# Habilita (true) ou desabilita (false) o uso do Elasticsearch.
ELASTICSEARCH_ACTIVE=false

# ELASTICSEARCH
# URL de conexão para a instância do Elasticsearch, caso ativo.
ELASTICSEARCH=http://localhost:9200

# APP_NAME
# Identificador da aplicação usado para diferenciar os logs no Elasticsearch.
APP_NAME=conquistaserv-backend


# ==============================================================================
# CONFIGURAÇÕES DE AUTENTICAÇÃO E SEGURANÇA (JWT)
# ==============================================================================
# Este bloco controla a geração e validação de tokens JWT (JSON Web Token),
# responsáveis pela autenticação de usuários na API.

# JWT_SECRET
# Chave secreta criptográfica utilizada para assinar os tokens JWT.
# Em produção, deve ser uma string longa, complexa e mantida em sigilo absoluto.
JWT_SECRET=super_secret_key_change_in_production

# JWT_EXPIRE
# Define o tempo de validade do token JWT antes da expiração.
# Pode ser especificado em segundos (ex: 86400s) ou formato de tempo (ex: 1d).
JWT_EXPIRE=86400s


# ==============================================================================
# CONFIGURAÇÕES DE BANCO DE DADOS
# ==============================================================================
# Este bloco estabelece a string de conexão para a base de dados principal.

# FRONTEND_URLS
# Origens (URLs) autorizadas a fazer requisições à API (CORS), separadas por vírgula.
# Exemplo: http://localhost:8080,https://app.seudominio.com
FRONTEND_URLS=http://localhost:8080

# DATABASE_URL
# String de conexão do Prisma ORM para o PostgreSQL. 
# Formato padrão: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conquistaserv?schema=public"


# ==============================================================================
# CONFIGURAÇÕES DE INFRAESTRUTURA
# ==============================================================================

# SSL
# Habilita ou desabilita a configuração nativa de SSL no Node.js.
# Caso utilize um Proxy Reverso (como o Nginx Proxy Manager), deixe como 'false'.
# Adicionadas variáveis JWT necessárias pelo backend da aplicação
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRATION=86400s
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRATION=604800s
SSL=false

# ==============================================================================
# CONFIGURAÇÕES DA IA
# ==============================================================================
OPENAI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
AI_TEMPERATURE=0
AI_CHUNK_SIZE=1000
AI_CHUNK_OVERLAP=200
AI_DOCS_PATH=./docs/training
AI_SYSTEM_PROMPT_PATH=./docs/prompts/system-prompt.md
